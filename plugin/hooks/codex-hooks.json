{
  "description": "planvil workflow enforcement for Codex",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planvil-hook\" session-start codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planvil-hook\" prompt codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planvil-hook\" pre-tool codex",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planvil-hook\" post-tool codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$PLUGIN_ROOT/bin/planvil-hook\" stop codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
